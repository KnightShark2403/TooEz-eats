# ─────────────────────────────────────────────────────────────────────────────
# TooEz environment
# Copy to .env.local  ->  cp .env.example .env.local
# Nothing here is required to boot: with no keys the app runs on a clearly
# labelled MOCK gateway. Add the Razorpay keys to run the real integration.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Razorpay (TEST MODE) ---------------------------------------------------
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key
# The key id is sent to the browser (that is by design); the secret never is.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard -> Settings -> Webhooks -> Add New Webhook
# Set a secret of your choosing there and paste the SAME value here.
# Subscribe to: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=choose_any_strong_string

# ---- Optional: LLM narration ------------------------------------------------
# Used ONLY to phrase reasoning. It never computes a price, margin, forecast or
# risk verdict. Leave both unset and the app uses deterministic sentences.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- Optional ---------------------------------------------------------------
# TOOEZ_DB_PATH=./data/tooez.db
# TOOEZ_MERCHANT_ID=mrc_campuskitchen
